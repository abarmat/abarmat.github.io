<!DOCTYPE html>
<html lang="en">
  <head>
    {% set pageTitle = title or meta.title %}
    {% set pageDescription = description or meta.description %}
    {% set canonicalUrl = page.url | htmlBaseUrl(meta.base) %}
    {% set pageImage = socialImage or meta.images.socialDefault.src %}
    {% set pageImageUrl = pageImage | htmlBaseUrl(meta.base) %}
    {% set pageImageAlt = socialImageAlt or meta.images.socialDefault.alt %}
    {% set pageImageWidth = socialImageWidth or meta.images.socialDefault.width %}
    {% set pageImageHeight = socialImageHeight or meta.images.socialDefault.height %}
    {% set pageType = openGraphType or "website" %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <link rel="canonical" href="{{ canonicalUrl }}" />
    <meta property="og:site_name" content="{{ meta.title }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:type" content="{{ pageType }}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:image" content="{{ pageImageUrl }}" />
    <meta property="og:image:width" content="{{ pageImageWidth }}" />
    <meta property="og:image:height" content="{{ pageImageHeight }}" />
    <meta property="og:image:alt" content="{{ pageImageAlt }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    <meta name="twitter:image" content="{{ pageImageUrl }}" />
    <meta name="twitter:image:alt" content="{{ pageImageAlt }}" />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="apple-touch-icon"
      sizes="300x300"
      href="{{ meta.images.appleTouchIcon }}"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="{{ meta.images.favicon }}"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ariel Barmat"
      href="/feed.rss"
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Ariel Barmat"
      href="/feed.atom"
    />
  </head>

  <body>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <small>
        2026
      {% if meta.buildCommitSha %}
        | {{ meta.buildCommitSha }}
      {% endif %}
      </small>
    </footer>
  </body>
</html>
