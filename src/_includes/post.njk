---
layout: base-with-nav.njk
title: Post | abarmat.com
nav: posts
permalink: "/{{ title | slugify }}/"
---

<div class="post-content">
    <section>
        <h1>{{ title }}</h1>
        <div class="publish-date">{{ date | dateFilter }}</div>
        <!-- post-body-start -->
        {{ content | safe }}
        <!-- post-body-end -->
    </section>
    {% if path %}
    <p class="post-origin">
        Originally published <a href="{{ path }}">{{ date | dateFilter }}</a>
    </p>
    {% endif %}
</div>
